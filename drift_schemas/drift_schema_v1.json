  "fixed_sql": [
    {
      "name": "techniques",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"techniques\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"slug\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"family\" TEXT NOT NULL CHECK(\"family\" IN ('punch', 'elbow', 'kick', 'knee', 'defense', 'footwork')), \"default_side\" TEXT NULL CHECK(\"default_side\" IN ('lead', 'rear')), \"default_target\" TEXT NULL CHECK(\"default_target\" IN ('head', 'body', 'legs')), \"position\" INTEGER NOT NULL UNIQUE);"
        }
      ]
    },
    {
      "name": "technique_sides",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"technique_sides\" (\"technique_id\" INTEGER NOT NULL REFERENCES techniques (id), \"side\" TEXT NOT NULL CHECK(\"side\" IN ('lead', 'rear')), PRIMARY KEY (\"technique_id\", \"side\"));"
        }
      ]
    },
    {
      "name": "technique_targets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"technique_targets\" (\"technique_id\" INTEGER NOT NULL REFERENCES techniques (id), \"target\" TEXT NOT NULL CHECK(\"target\" IN ('head', 'body', 'legs')), PRIMARY KEY (\"technique_id\", \"target\"));"
        }
      ]
    },
    {
      "name": "combos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"combos\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NULL, \"signature\" TEXT NOT NULL UNIQUE, \"box\" INTEGER NOT NULL CHECK(\"box\" BETWEEN 1 AND 6), \"due_on\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "combo_steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"combo_steps\" (\"combo_id\" INTEGER NOT NULL REFERENCES combos (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL CHECK(\"position\" BETWEEN 0 AND 11), \"technique_id\" INTEGER NOT NULL REFERENCES techniques (id) ON DELETE RESTRICT, \"side\" TEXT NULL CHECK(\"side\" IN ('lead', 'rear')), \"target\" TEXT NULL CHECK(\"target\" IN ('head', 'body', 'legs')), PRIMARY KEY (\"combo_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "reviews",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reviews\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"combo_id\" INTEGER NOT NULL REFERENCES combos (id) ON DELETE CASCADE, \"reviewed_at\" TEXT NOT NULL, \"grade\" TEXT NOT NULL CHECK(\"grade\" IN ('hard', 'good', 'easy')));"
        }
      ]
    },
    {
      "name": "combos_due_on",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX combos_due_on ON combos (due_on)"
        }
      ]
    },
    {
      "name": "combo_steps_technique_id",
      "sql": [
